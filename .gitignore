# 1. Security (CRITICAL)
.env
# Never upload .env. It contains your Database Password and Encryption Key.

# 2. Python Environment & Bytecode
venv/
__pycache__/
*.pyc

# 3. Docker Database Data (Heavy)
postgres_data/
# This folder contains the running database files.

# 4. User Uploads
uploads/
# Contains the files uploaded to cards.

# 5. Backups (CRITICAL)
backups/
# Contains the SQL dumps generated by backup.sh.
*.sql
*.enc

# 6. IDE Settings (Optional)
.vscode/
.idea/
